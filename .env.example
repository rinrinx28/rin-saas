# ──────────────────────────────────────────────────────────────
# Supabase (cloud) — copy file này thành .env.local rồi điền giá trị.
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ──────────────────────────────────────────────────────────────
# Thanh toán gói cước qua chuyển khoản (SePay/Casso) — VN-specific
# ──────────────────────────────────────────────────────────────
# Thông tin tài khoản nhận tiền (hiển thị + tạo VietQR)
NEXT_PUBLIC_BANK_NAME=Vietcombank
NEXT_PUBLIC_BANK_ACCOUNT=0123456789
NEXT_PUBLIC_BANK_BIN=970436
# Khóa xác thực webhook SePay (Authorization: Apikey <key>)
SEPAY_WEBHOOK_API_KEY=YOUR-SEPAY-WEBHOOK-KEY
# Bật nút "đã chuyển khoản (giả lập)" ở môi trường dev
NEXT_PUBLIC_PAYMENT_SIMULATE=true

# ──────────────────────────────────────────────────────────────
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
